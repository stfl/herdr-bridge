#!/usr/bin/env bash
# Stub herdr. Logs every call, answers from fixtures, and reproduces the real
# binary's quirks — notably that `status server` reports a dead socket on
# stdout and still exits 0.
set -u
printf 'herdr %s\n' "$*" >>"${HB_CALLS:-/dev/null}"

case "${1:-} ${2:-}" in
  "status server")
    # HB_SERVER_DOWN models the case the real binary is careless about: the
    # socket file is present but nothing is listening. Either way this exits
    # 0, exactly as herdr does.
    if [ -n "${HERDR_SOCKET_PATH:-}" ] && [ -S "${HERDR_SOCKET_PATH}" ] &&
      [ "${HB_SERVER_DOWN:-0}" != 1 ]; then
      printf 'status: running\nsocket: %s\n' "$HERDR_SOCKET_PATH"
    else
      printf 'status: not running\nsocket: %s\n' "${HERDR_SOCKET_PATH:-}"
    fi
    exit 0
    ;;
  "session list")
    if [ "${3:-}" = "--json" ]; then
      cat "$HB_FIXTURES/$HB_SESSIONS"
    else
      printf 'name                 status   directory\n'
      printf 'default              running  /home/u/.config/herdr\n'
    fi
    exit 0
    ;;
  "agent list")
    if [ -z "${HERDR_SOCKET_PATH:-}" ] || [ ! -S "${HERDR_SOCKET_PATH}" ]; then
      printf '{"error":{"code":"server_not_running"}}\n'
      exit 1
    fi
    cat "$HB_FIXTURES/$HB_AGENTS"
    exit 0
    ;;
  "agent get")
    # Without HERDR_SOCKET_PATH this is a query against the local session,
    # which is how --release reads the row it is asked to clear.
    if [ -z "${HERDR_SOCKET_PATH:-}" ]; then
      [ -n "${HB_LOCAL_ROW:-}" ] && [ -f "$HB_LOCAL_ROW" ] || exit 1
      cat "$HB_LOCAL_ROW"
      exit 0
    fi
    # HB_AGENT_GET_FILE lets a test rewrite the answer while the bridge runs,
    # so the mirror loop can be watched picking a change up.
    file="${HB_AGENT_GET_FILE:-$HB_FIXTURES/${HB_AGENT_GET:-}}"
    [ -f "$file" ] || exit 1
    # Only the pane the fixture describes exists.
    want=$(sed -n 's/.*"pane_id":"\([^"]*\)".*/\1/p' "$file" | head -1)
    if [ -n "${3:-}" ] && [ -n "$want" ] && [ "$3" != "$want" ]; then
      printf '{"error":{"code":"agent_not_found"}}\n'
      exit 1
    fi
    cat "$file"
    exit 0
    ;;
  "agent attach")
    case "${HB_ATTACH_MODE:-exit0}" in
      exit0) exit 0 ;;
      fail) exit 1 ;;
      hang) exec sleep 300 ;;
    esac
    ;;
  "pane report-agent" | "pane report-metadata" | "pane release-agent")
    exit 0
    ;;
esac
exit 0
