#!/usr/bin/env bash
# Takes the lock and holds it until killed, leaving a stale lock of whatever
# shape the implementation actually uses. `exec` so the signal reaches the
# sleep itself, and clean fds so an orphan cannot hold the test's output pipe
# open and stall the run.
set -uo pipefail
# shellcheck disable=SC1090
source "$HB_BIN"
LOCK_TIMEOUT=30 lock_acquire h s
: >"$HB_READY"
exec sleep 300 >/dev/null 2>&1
